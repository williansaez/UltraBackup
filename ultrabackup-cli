#!/usr/bin/env python3
"""Wrapper executável do UltraBackup.

Vive na raiz do repositório, ao lado do diretório do pacote ``ultrabackup/``
(daí o nome ``ultrabackup-cli`` — um arquivo chamado ``ultrabackup`` colidiria
com o diretório do pacote). Adiciona o próprio diretório (que é o pai do
pacote) ao ``sys.path`` e executa o main do pacote. ``os.path.realpath``
resolve symlinks, então é seguro criar um link ``ultrabackup`` em ~/bin
apontando para este arquivo.
"""

import os
import sys


def _run() -> int:
    package_parent = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
    if package_parent not in sys.path:
        sys.path.insert(0, package_parent)
    from ultrabackup.cli import main

    return main()


if __name__ == "__main__":
    sys.exit(_run())
